---
import Section from "./Section.astro";
import SectionHeader from "./SectionHeader.astro";
import { getCollection } from "astro:content";

const projects = await getCollection("projects");
---

<Section dark={true}>
  <SectionHeader
    heading="My Projects"
    cta={{ text: "View All", href: "/projects" }}
  />
  <div class="projects-container">
    {
      projects.map((project) => (
        <div class="card">
          <h3>
            <a href={project.data.title}>{project.data.title}</a>
          </h3>
          <p class="dates">
            {project.data.fromdate} &ndash; {project.data.todate}
          </p>
          <ul class="tasks">
            {project.data.tasks.map((task) => (
              <li>{task}</li>
            ))}
          </ul>
          <ul class="skills">
            {project.data.skills.map((skill) => (
              <li>{skill}</li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</Section>

<style>
  .projects-container {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 24px;

    .card {
      overflow: hidden;
      transition: transform 0.3s;
      display: flex;
      flex-direction: column;
    }

    h3 {
      margin-top: 20px;
    }

    a {
      text-decoration: none;
      color: var(--dark);
      font-weight: 600;
      font-size: 18px;
    }
    .dates {
      margin-top: 8px;
      font-size: 14px;
      color: var(--primary);
    }

    .tasks {
      margin-top: 12px;
      padding-left: 18px;
      font-size: 14px;
      line-height: 1.5;

      li {
        margin-bottom: 4px;
      }
    }

    .skills {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: 16px;
      padding: 0;
      list-style: none;

      li {
        background: var(--white);
        border: 1px solid var(--dark);
        border-radius: 12px;
        padding: 4px 12px;
        font-size: 12px;
      }
    }
    @media (max-width: 700px) {
      & {
        grid-template-columns: 1fr;
      }
    }
  }
</style>
