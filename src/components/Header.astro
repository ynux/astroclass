---
import ButtonLink from "../components/ButtonLink.astro";
import Container from "../components/Container.astro";
---
<Container>
  <header id="header">
		<div class="content">
			<h1>
                <span>Hi, I am Suny.</span>
				<span>You will <span class="accent">always</span> remember me.</span>
			</h1>
			<p class="description">
				I do DevOps, mostly in clouds.
			</p>
			<div class="button-container">
        <ButtonLink href="/projects" text="View projects" variant="secondary" />
        <ButtonLink href="/resume.pdf" text="Download resume" variant="primary" isDownload={true} />
			</div>
		</div>
		<img src="/images/sunygrin-canva-quadrat.png" width="200" height="200" alt="A picture of me" />
	</header>
</Container>
<style>

  #header {
    display: grid;
    grid-template-columns: 540px 1fr;
    justify-items: center;
    gap: 80px;
    align-items: center;

    h1 {
      font-size: 24px;             /* Schriftgröße (beliebig anpassbar) */
      margin-bottom: 30px;         /* Abstand zum nachfolgenden Inhalt */
      display: flex;               /* Flexbox aktivieren */
      flex-direction: column;      /* Elemente untereinander anordnen */
      gap: 10px;                   /* Optional: Abstand zwischen den Elementen im Header */
      padding: 15px;               /* Optional: Innenabstand */
    
      .accent {
        color: var(--primary);     
      }
    } 
    


    .description {
      line-height: 28px;
      color: var(--dark);
      margin-bottom: 30px;
    }

    @media (max-width: 1000px) {
      & {
        grid-template-columns: 1fr;
        grid-template-rows: auto;
        gap: 40px;

        img {
          grid-row: 1;
        }
      }
    }

    @media (max-width: 600px) {
      & {
        grid-template-columns: 1fr;
        grid-template-rows: auto;
        gap: 40px;

        img {
          grid-row: 1;
        }
      }
    }
  /* Media Query für mobile Bildschirme bis maximal 600px Breite */
@media (max-width: 600px) {
  .button-container {
    flex-direction: column;    /* Ändert die Ausrichtung von horizontal zu vertikal */
    align-items: stretch;      /* Optional: Zwingt die Buttons, die volle Breite einzunehmen */
    padding-left: 30px;
    padding-right: 30px;
  }
}
 
} 
</style>