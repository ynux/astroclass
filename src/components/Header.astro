---
import ButtonLink from "../components/ButtonLink.astro";
import Section from "../components/Section.astro";
---

<Section>
  <header id="header">
    <div class="content">
      <h1>
        <span>Hi, I am Suny.</span>
        <span>You will <span class="accent">always</span> remember me.</span>
      </h1>
      <p class="description">I do DevOps, mostly in clouds.</p>
      <div class="button-container">
        <ButtonLink href="/projects" text="View projects" variant="secondary" />
        <ButtonLink
          href="/resume_kim_202607.pdf"
          text="Download resume"
          variant="secondary"
          isDownload={true}
        />
        <ButtonLink
          href="/lebenslauf_kim_202607.pdf"
          text="Lebenslauf herunterladen"
          variant="secondary"
          isDownload={true}
        />
      </div>
    </div>
    <img
      src="/images/sunypage_temp_portrait.png"
      width="200"
      height="200"
      alt="Suny face"
    />
  </header>
</Section>
<style>
  #header {
    display: grid;
    grid-template-columns: 540px 1fr;
    justify-items: center;
    gap: 80px;
    align-items: center;
    img {
      border-radius: 5%;
    }
    h1 {
      font-size: 44px;
      display: flex;
      flex-direction: column;
      margin-bottom: 20px;

      .accent {
        color: var(--primary);
      }
    }

    .button-container {
      display: flex;
      gap: 10px;
    }

    .description {
      line-height: 28px;
      color: var(--dark);
      margin-bottom: 30px;
    }

    @media (max-width: 1000px) {
      & {
        grid-template-columns: 1fr;
        grid-template-rows: auto;
        gap: 40px;

        img {
          grid-row: 1;
        }
      }
    }

    @media (max-width: 600px) {
      .button-container {
        flex-direction: column;
      }
    }
  }
</style>
