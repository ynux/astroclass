---
interface Props {
  href: string;
  text: string;
  variant?: "primary" | "secondary";
  isDownload?: boolean;
}

const { href, text, variant = "primary", isDownload } = Astro.props;
---

{
  isDownload && (
    <a class={`button-link ${variant}`} download href={href}>
      {text}
    </a>
  )
}

{
  !isDownload && (
    <a class={`button-link ${variant}`} href={href}>
      {text}
    </a>
  )
}

<style>
  a {
    padding: 10px 26px;
    display: block;
    underline: none;
    width: 180px;
    text-align: center;
    text-decoration: none;
    font-size: 14px;
    text-align: center;
    border-radius: 5%;
  }

  @media screen and (max-width: 600px) {
    a {
      font-size: 14px;
      width: 100%;
    }
  }

  .primary {
    background: white;
    color: var(--dark);
    border: 1px solid var(--dark);
  }
  .secondary {
    background: white;
    color: var(--primary);
    border: 1px solid var(--primary);
  }
</style>
