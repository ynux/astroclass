---
import Section from "./Section.astro";
---

<Section id="footer" dark={true}>
  <!-- wrap with section component -->
  <footer>
    <div class="icons-container">
      <a href="mailto:stkim@gmx.net"
        ><img src="images/icons/email.svg" alt="email icon" /></a
      >
      <a href="https://github.com/ynux"
        ><img src="images/icons/github.svg" alt="github icon" /></a
      >
      <a href="https://www.linkedin.com/in/suny-kim-83b94688/"
        ><img src="images/icons/linkedin.svg" alt="linkedin icon" /></a
      >
      <a href="https://ynuxtechblog.wordpress.com"
        ><img src="images/icons/WordPress-logotype-wmark.png" width="50" />
      </a>
    </div>
  </footer>

  <style>
    footer {
      display: flex;
      align-items: center;
      flex-direction: column;

      .icons-container {
        display: flex;
        gap: 20px;
        margin-bottom: 20px;
        align-items: center;
      }

      .credit-text {
        color: var(--light);
        margin-top: 8px;
        font-size: 14px;
      }

      @media screen and (max-width: 500px) {
        .icons-container {
          flex-direction: column;
          gap: 4px;
          img {
            height: 20px;
          }
        }
      }
    }
  </style>
</Section>
