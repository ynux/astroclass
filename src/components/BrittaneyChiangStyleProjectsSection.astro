---
import { Image } from 'astro:assets';

interface Project {
  title: string;
  description: string;
  link: string;
  tech: string[];
  // Neue Felder
  slug: string;
  image: string;
  industry: string;
  dateRange: {
    fromDate: string;
    toDate: string;
  };
}

// Beispiel-Datenmatrix mit den neuen Feldern
const projects: Project[] = [
  {
    slug: "spotify-connected-app",
    title: "Build a Spotify Connected App",
    description: "A comprehensive video course teaching REST API integrations, user authentication flows, Node, Express, and React to display real-time user metrics.",
    link: "https://brittanychiang.com",
    tech: ["React", "Express", "Spotify API", "Node.js"],
    image: "/images/spotify-dashboard.jpg", // Pfad zu deinem Asset
    industry: "Entertainment / EdTech",
    dateRange: {
      fromDate: "2024",
      toDate: "now" // Wird im UI zu "Present" oder "Heute" gewandelt
    }
  },
  {
    slug: "halcyon-theme",
    title: "Halcyon Theme for VS Code",
    description: "A minimal, dark blue utility theme optimized for clarity and reduced eye strain. Reached over 100k+ organic installs on the extensions marketplace.",
    link: "https://github.com",
    tech: ["VS Code", "JSON", "UI Design"],
    image: "/images/halcyon-vscode.jpg",
    industry: "Developer Tools",
    dateRange: {
      fromDate: "2022",
      toDate: "2023"
    }
  }
];
---

<section id="projects" class="mb-16 scroll-mt-16 md:mb-24 lg:mb-36" aria-label="Selected Projects">
  <!-- Sticky Header für mobile Layouts -->
  <div class="sticky top-0 z-20 -mx-6 mb-4 w-screen bg-[#0a192f]/75 px-6 py-5 backdrop-blur md:-mx-12 md:px-12 lg:sr-only lg:relative lg:top-auto lg:mx-0 lg:w-auto lg:px-0 lg:py-0 lg:opacity-0">
    <h2 class="text-sm font-bold uppercase tracking-widest text-[#e2e8f0] lg:sr-only">Projects</h2>
  </div>

  <div>
    <ul class="group/list">
      {projects.map((project) => (
        <li class="mb-12" id={project.slug}>
          <div class="group relative grid gap-4 pb-1 transition-all sm:grid-cols-8 sm:gap-8 md:gap-4 lg:hover:!opacity-100 lg:group-hover/list:opacity-50">
            
            <!-- Hover Hintergrund-Effekt -->
            <div class="absolute -inset-x-4 -inset-y-4 z-0 hidden rounded-md transition motion-reduce:transition-none lg:-inset-x-6 lg:block lg:group-hover:bg-slate-800/50 lg:group-hover:shadow-[inset_0_1px_0_0_rgba(148,163,184,0.1)] lg:group-hover:drop-shadow-lg"></div>
            
            <!-- Linke Spalte: Datum & Bild-Vorschau -->
            <div class="z-10 sm:col-span-2 flex flex-col gap-2">
              <!-- Datumsbereich & Industrie -->
              <div class="text-xs font-semibold tracking-wide text-slate-500 uppercase font-mono">
                {project.dateRange.fromDate} — {project.dateRange.toDate.toLowerCase() === 'now' ? 'Present' : project.dateRange.toDate}
              </div>
              <div class="text-[11px] text-teal-400/80 font-medium tracking-wider uppercase">
                {project.industry}
              </div>
              
              <!-- Projekt-Bild (Nutzt Astros optimiertes Image-Handling falls lokaler Import, hier als Fallback über Standard-IMG wegen String-Pfad) -->
              <div class="mt-1 hidden sm:block">
                <img 
                  src={project.image} 
                  alt={`Screenshot of ${project.title}`}
                  class="rounded border-2 border-slate-700/30 bg-slate-900 object-cover w-full aspect-[16/10] transition group-hover:border-slate-700/70"
                  loading="lazy"
                />
              </div>
            </div>

            <!-- Rechte Spalte: Content Area -->
            <div class="z-10 sm:col-span-6">
              <h3 class="font-medium leading-snug text-slate-200">
                <div>
                  <a class="inline-flex items-baseline font-medium leading-tight text-slate-200 hover:text-teal-300 focus-visible:text-teal-300 text-base group/link" href={project.link} target="_blank" rel="noreferrer">
                    <!-- Macht die gesamte Card anklickbar -->
                    <span class="absolute -inset-x-4 -inset-y-4 hidden rounded md:-inset-x-6 lg:block"></span>
                    <span>
                      {project.title}
                      <span class="inline-block">
                        <svg xmlns="http://w3.org" viewBox="0 0 20 20" fill="currentColor" class="inline-block h-4 w-4 shrink-0 transition-transform group-hover/link:-translate-y-1 group-hover/link:translate-x-1 motion-reduce:transition-none ml-1 translate-y-px" aria-hidden="true">
                          <path fill-rule="evenodd" d="M5.22 14.78a.75.75 0 001.06 0l7.22-7.22v5.69a.75.75 0 001.5 0v-7.5a.75.75 0 00-.75-.75h-7.5a.75.75 0 000 1.5h5.69l-7.22 7.22a.75.75 0 000 1.06z" clip-rule="evenodd"></path>
                        </svg>
                      </span>
                    </span>
                  </a>
                </div>
              </h3>
              
              <p class="mt-2 text-sm leading-normal text-slate-400">
                {project.description}
              </p>
              
              <!-- Tech Pill Cloud -->
              <ul class="mt-2 flex flex-wrap" aria-label="Technologies used">
                {project.tech.map((techItem) => (
                  <li class="mr-1.5 mt-2">
                    <div class="flex items-center rounded-full bg-teal-400/10 px-3 py-1 text-xs font-medium leading-5 text-teal-300">
                      {techItem}
                    </div>
                  </li>
                ))}
              </ul>
            </div>

          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
