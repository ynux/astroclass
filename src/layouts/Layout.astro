---
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="./images/icons/favicon-16x16-sunydianastuhl.png"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Epilogue:ital,wght@0,100..900;1,100..900&display=swap"
      rel="stylesheet"
    />
    <meta name="generator" content={Astro.generator} />
    <title>Suny</title>
  </head>
  <body>
    <Navbar />
    <slot />
    <Footer />
  </body>
  <style is:global>
    body {
      margin: 0;
      padding: 0;
      font-family: "Epilogue", sans-serif;
    }

    h1 {
      weight: 700;
      font-size: 44px;
      margin-bottom: 80px;
    }

    p {
      line-height: 24px;
    }

    pre {
      padding: 16px;
      border-radius: 5px;
    }

    * {
      box-sizing: border-box;
      color: var(--dark);
      margin: 0;
    }

    :root {
      --primary: #702309;
      --secondary: #e6f1f5;
      --white: #ffffff;
      --dark: #1d0b55;
      --light: #96ba2e;
      --other: #eef3ef;
    }

    .portfolio-card-glow {
      @apply absolute -inset-x-4 -inset-y-4 z-0 hidden rounded-md transition motion-reduce:transition-none 
           lg:-inset-x-6 lg:block 
           lg:group-hover:bg-slate-800/50 
           lg:group-hover:shadow-[inset_0_1px_0_0_rgba(48,63,84,2)] 
           lg:group-hover:drop-shadow-lg;
    }
  </style>
</html>
