/* google ai written */
interface Props { title: string; } const { title } = Astro.props;

<html lang="de" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body
    class="bg-[#0a192f] text-slate-400 antialiased selection:bg-teal-300 selection:text-teal-900 relative min-h-screen"
  >
    <!-- Der globale Maus-Glow-Hintergrund -->
    <div
      id="mouse-glow"
      class="pointer-events-none fixed inset-0 z-30 transition duration-300 lg:absolute"
    >
    </div>

    <!-- Globaler Wrapper für den Content-Dimming-Effekt -->
    <div
      class="global-hover-group mx-auto min-h-screen max-w-screen-xl px-6 py-12 font-sans md:px-12 md:py-20 lg:px-24 lg:py-0"
    >
      <slot />
    </div>

    <!-- Ultraschnelles, passives Skript für den Maus-Effekt -->
    <script>
      const glow = document.getElementById("mouse-glow");

      if (glow && window.innerWidth >= 1024) {
        // Nur auf Desktop aktivieren
        window.addEventListener("mousemove", (e) => {
          // Berechnet die Position relativ zum Dokument (wichtig beim Scrollen!)
          const x = e.pageX;
          const y = e.pageY;

          glow.style.background = `radial-gradient(600px at ${x}px ${y}px, rgba(29, 78, 216, 0.15), transparent 80%)`;
        });
      }
    </script>
  </body>
</html>

<style is:global>
  /* Globaler Sektions-Wechsel-Effekt im Brittany-Chiang-Stil */

  /* 1. Wenn die Maus IM Haupt-Wrapper ist, dimmen wir standardmäßig ALLES leicht ab */
  .global-hover-group:hover .hover-card-trigger {
    @apply opacity-50 transition-all duration-300;
  }

  /* 2. Das Element, über dem die Maus gerade schwebt, wird voll beleuchtet */
  .global-hover-group .hover-card-trigger:hover {
    @apply opacity-100 scale-[1.01] bg-slate-800/40 shadow-[inset_0_1px_0_0_rgba(148,163,184,0.1)] drop-shadow-lg;
  }

  /* Globale Link-Animationen für Fließtext (Abseits von Karten) */
  a.inline-link {
    @apply text-slate-200 font-medium hover:text-teal-300 transition-colors relative inline-block;
  }
</style>
